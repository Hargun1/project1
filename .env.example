# ──────────────────────────────────────────────────────────────────────────────
# Copy to `.env` at the repository root and adjust.
#
#   cp .env.example .env
#
# ONE .env at the root is the single source of truth: docker compose reads it
# directly, the backend loads it via dotenv, and Vite reads it via `envDir`.
# The backend validates every variable below with Zod at startup and refuses to
# boot if anything is missing or malformed (see backend/src/config/env.schema.js).
# ──────────────────────────────────────────────────────────────────────────────

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# Origin allowed by CORS and used for cookie/redirect decisions.
CLIENT_URL=http://localhost:5173
# Serve the built React frontend from Express (Render single-origin hosting).
SERVE_FRONTEND=false

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# POSTGRES_* are consumed by docker compose to provision the container.
POSTGRES_USER=collab
POSTGRES_PASSWORD=collab_dev_password
POSTGRES_DB=collab_editor
POSTGRES_PORT=5432
# DATABASE_URL is consumed by Prisma (must match the values above).
DATABASE_URL=postgresql://collab:collab_dev_password@localhost:5432/collab_editor?schema=public

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── Auth (used from Phase 2) ──────────────────────────────────────────────────
# Minimum 32 characters. Generate with: openssl rand -base64 48
# The app refuses to start in production while these still contain "change-me".
JWT_SECRET=change-me-development-only-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-development-only-refresh-secret-32-chars

# ── Collaboration / persistence (used from Phase 5 onward) ────────────────────
# Lifetime of a single-use WebSocket connection ticket.
WS_TICKET_TTL_SECONDS=30
# Idle time before a Y.Doc snapshot is persisted to PostgreSQL.
DOC_SNAPSHOT_DEBOUNCE_MS=2000
# Minimum spacing of automatic revisions while a document is edited (5 min).
DOC_REVISION_INTERVAL_MS=300000
# Hard cap on a single document's Yjs state (1 MiB).
MAX_DOCUMENT_SIZE_BYTES=1048576

# ── Rate limits (Phase 11) ─────────────────────────────────────────────────────
# Auth endpoints per client IP per minute; login attempts per email per 15 min.
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_LOGIN_PER_EMAIL=10
# Authenticated API requests per user per minute.
RATE_LIMIT_API_PER_MINUTE=300
# WebSocket connection attempts per IP per minute; messages per socket.
RATE_LIMIT_WS_CONNECT_PER_MINUTE=30
WS_MESSAGES_PER_SECOND=40
WS_MESSAGE_BURST=200
# Reverse proxies in front whose X-Forwarded-For entries are trusted (Nginx = 1;
# ALB + Nginx = 2). Decides the client IP that rate limits count.
# TRUST_PROXY_HOPS=1
# Refresh session TTL in Redis, in seconds (default: 7 days = 604800).
REFRESH_TOKEN_EXPIRY_SECONDS=604800

# ── Docker stack (Phases 12 and 14: `npm run stack:up`) ───────────────────────
# Only read by docker compose for the full stack; defaults shown. The stack runs
# with NODE_ENV=production, so the JWT secrets above must be real values.
# Change CLIENT_URL together with the port, or the Origin checks refuse the browser.
# STACK_HTTPS_PORT=8443
# STACK_HTTP_PORT=8080            # only redirects to HTTPS
# STACK_CLIENT_URL=https://localhost:8443
# BACKEND_REPLICAS=2              # or: docker compose --profile app up -d --scale backend=3
# STACK_LOG_LEVEL=info

# ── Frontend (Vite only exposes VITE_-prefixed variables to the browser) ──────
# Empty means "same origin": the Vite dev server proxies /api, /healthz, /readyz
# to the backend, and in production Nginx does the same.
VITE_API_BASE_URL=
