{
  // CommonJS build — consumed by the backend (which runs plain Node, no bundler)
  // and the source of the .d.ts files both workspaces type-check against.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "rootDir": "src",
    "outDir": "dist/cjs",
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src"]
}
