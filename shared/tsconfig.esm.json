{
  // ES module build — consumed by the frontend. Rollup cannot statically resolve
  // named exports out of TypeScript's CommonJS `__exportStar` output, so shipping
  // only the CJS build breaks `vite build` on `import { isRole } from
  // '@collab/shared'`. Declarations come from the CJS build, not this one.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist/esm",
    "declaration": false,
    "declarationMap": false
  }
}
