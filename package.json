{
  "name": "collaborative-code-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time collaborative code editor (Monaco + Yjs CRDT + Redis Pub/Sub + PostgreSQL)",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace @collab/backend",
    "dev:frontend": "npm run dev --workspace @collab/frontend",
    "build": "npm run build --workspace @collab/frontend",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @collab/backend",
    "db:migrate": "npm run db:migrate --workspace @collab/backend",
    "db:deploy": "npm run db:deploy --workspace @collab/backend",
    "db:studio": "npm run db:studio --workspace @collab/backend",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "stack:up": "docker compose --profile app up -d --build --wait",
    "stack:down": "docker compose --profile app down",
    "stack:logs": "docker compose --profile app logs -f --tail=100",
    "stack:smoke": "node scripts/smoke-stack.mjs",
    "stack:e2e": "node scripts/browser-e2e.mjs",
    "stack:resilience": "node scripts/resilience-stack.mjs",
    "stack:scale": "node scripts/scaling-stack.mjs",
    "test:integration": "npm run test:integration --workspace @collab/backend",
    "test:coverage": "npm run test:coverage --workspace @collab/backend"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "playwright-core": "^1.49.1",
    "prettier": "^3.4.2"
  },
  "overrides": {
    "monaco-editor": "0.52.2"
  }
}
