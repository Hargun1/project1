{
  "name": "collaborative-code-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time collaborative code editor (Monaco + Yjs CRDT + Redis Pub/Sub + PostgreSQL)",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace @collab/shared",
    "dev:backend": "npm run dev --workspace @collab/backend",
    "dev:frontend": "npm run dev --workspace @collab/frontend",
    "build": "npm run build:shared && npm run build --workspace @collab/backend && npm run build --workspace @collab/frontend",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @collab/backend",
    "db:migrate": "npm run db:migrate --workspace @collab/backend",
    "db:deploy": "npm run db:deploy --workspace @collab/backend",
    "db:studio": "npm run db:studio --workspace @collab/backend",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
