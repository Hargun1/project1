// Prisma schema — see docs/database.md for the reasoning behind each decision.
//
// Table/column names are snake_case (`@@map` / `@map`) to match the SQL
// conventions in the specification, while the TypeScript client stays camelCase.
//
// Every DateTime is `@db.Timestamptz(3)`. Prisma's default for DateTime is
// `timestamp(3)` — WITHOUT time zone — which stores a wall-clock reading with no
// record of the offset it was taken in. Collaborators are in different zones, so
// "who edited this first" would depend on where the writer was sitting.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Mirrors the `Role` union exported from @collab/shared.
enum Role {
  OWNER
  EDITOR
  VIEWER
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  ownedDocuments   Document[]         @relation("DocumentOwner")
  memberships      DocumentMember[]
  createdRevisions DocumentRevision[]

  @@map("users")
}

model Document {
  id       String @id @default(uuid()) @db.Uuid
  ownerId  String @map("owner_id") @db.Uuid
  name     String @db.VarChar(255)
  language String @db.VarChar(32)

  /// The live document's full CRDT state: `Y.encodeStateAsUpdate()` output,
  /// overwritten on a debounce. NULL means "never edited" (an empty Y.Doc).
  ///
  /// This is the *current* state, which the server loads when a document is
  /// opened. It is deliberately binary, never text: re-creating a Y.Doc from text
  /// gives every character a new CRDT identity, so a client still holding the old
  /// state would merge both copies and duplicate the document on reconnect.
  /// Revision *history* (append-only) lives in `document_revisions` (Phase 9).
  yjsState Bytes? @map("yjs_state")

  /// Soft delete: revisions and membership history survive a "deleted" document.
  /// Every read path must filter on `deletedAt: null`.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner     User               @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   DocumentMember[]
  revisions DocumentRevision[]

  // Dashboard queries: "documents I own", "sorted by recently edited",
  // "filtered by language" — all with deleted rows excluded.
  @@index([ownerId, deletedAt])
  @@index([updatedAt(sort: Desc)])
  @@index([language])
  @@map("documents")
}

model DocumentMember {
  documentId String   @map("document_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  role       Role
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Composite primary key gives the (document_id, user_id) uniqueness the spec
  // requires, and is also the exact lookup an authorization check performs.
  @@id([documentId, userId])
  // Reverse direction: "documents shared with me".
  @@index([userId])
  @@map("document_members")
}

/// Why a revision exists. Mirrors REVISION_KINDS in @collab/shared.
enum RevisionKind {
  /// Periodic checkpoint taken while saving, and when everyone has left.
  AUTO
  /// "Save version" pressed by an OWNER or EDITOR.
  MANUAL
  /// Created by restoring an older revision (history is append-only).
  RESTORE
}

model DocumentRevision {
  id         String @id @default(uuid()) @db.Uuid
  documentId String @map("document_id") @db.Uuid

  /// Nullable so revision history outlives the account that created it.
  createdById String? @map("created_by") @db.Uuid

  /// Binary `Y.encodeStateAsUpdate()` output — NOT rendered text. Plain text
  /// discards the CRDT metadata (tombstones, client IDs) that makes a restore
  /// converge correctly.
  snapshot Bytes

  revisionNumber Int          @map("revision_number")
  kind           RevisionKind @default(AUTO)

  /// For RESTORE revisions: the revision number whose content was restored.
  /// A number, not a foreign key: revision numbers are immutable per document,
  /// and history rows are never deleted on their own.
  restoredFromNumber Int?     @map("restored_from_number")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  // Revision numbers are per-document and gap-free; the unique constraint is what
  // makes concurrent snapshot writers safe (the loser retries).
  @@unique([documentId, revisionNumber])
  @@index([documentId, createdAt(sort: Desc)])
  @@map("document_revisions")
}
