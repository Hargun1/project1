{
  "name": "@collab/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express + ws + Prisma backend for the collaborative code editor",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
